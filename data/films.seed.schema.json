{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jimc1682000/film-brain/data/films.seed.schema.json",
  "title": "film-brain seed file",
  "description": "Bring-your-own-films seed format consumed by scripts/seed_from_file.py. Brand-neutral: any film dataset that maps to this shape can populate the system (CATCHPLAY ingest is just one private source adapter producing this).",
  "type": "object",
  "required": ["version", "films"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "films": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "titles"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "description": "Stable unique id (films PK / Qdrant point)." },
          "titles": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "string" },
            "description": "Locale->title map, e.g. {\"zh\":\"…\",\"en\":\"…\"}. Primary resolves zh->en->first; DB stores zh+en (extra locales reserved)."
          },
          "description": { "type": "string", "description": "Embed/auto-tag body; recommended for search quality." },
          "tags": {
            "type": "array",
            "description": "Taxonomy tag_ids. Absent/empty -> seed with no tags, or LLM auto-tag with --auto-tag.",
            "items": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                {
                  "type": "object",
                  "required": ["tag_id"],
                  "additionalProperties": false,
                  "properties": {
                    "tag_id": { "type": "string", "minLength": 1 },
                    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
                  }
                }
              ]
            }
          },
          "poster": { "type": ["string", "null"], "description": "URL or data-URI; null -> UI placeholder." },
          "url": { "type": ["string", "null"], "description": "Canonical link (brand-neutral)." },
          "year": { "type": ["integer", "null"] },
          "country": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[A-Z]{2}$" },
            "description": "ISO 3166-1 alpha-2 codes."
          },
          "director": { "type": ["string", "null"] },
          "cast": { "type": ["string", "null"] }
        }
      }
    }
  }
}

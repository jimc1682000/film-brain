# ── LLM backend (runtime query understanding) ──────────────────────────────
# Which backend query-expansion uses: ollama | anthropic | gemini | openrouter
LLM_BACKEND=openrouter

# OpenRouter — primary cloud LLM (free tier). Get a key: https://openrouter.ai
OPENROUTER_API_KEY=your-key-here
OPENROUTER_PRIMARY_MODEL=openai/gpt-oss-20b:free
# Optional free-tier attribution headers (harmless if left blank)
OPENROUTER_REFERER=
OPENROUTER_TITLE=AI Film Library

# Local Ollama fallback model (used when cloud is down / no key)
LLM_FALLBACK_MODEL=qwen2.5:1.5b

# ── Tagging (auto-tag / re-analyze) cloud preference ───────────────────────
# Cloud backend tried first for tagging, with a circuit breaker → local fallback
TAGGING_CLOUD_BACKEND=openrouter

# ── Other LLM providers (optional) ─────────────────────────────────────────
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── External data ──────────────────────────────────────────────────────────
TMDB_API_KEY=your-key-here

# ── Vector DB (Qdrant) ─────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

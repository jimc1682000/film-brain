# Copy to `.env` and adjust. EVERYTHING here is optional — the defaults in
# backend/config.py are keyless (local Ollama for LLM + embedding), so the
# containerized quickstart runs with no .env at all. Uncomment only what you
# want to override. Full list of knobs: backend/config.py (Settings).

# ── LLM backend (runtime query understanding) ──────────────────────────────
# Which backend query-expansion uses: ollama | anthropic | gemini | openrouter
# Default is `ollama` (local, keyless). Switch to a cloud backend only if you
# set the matching API key below.
#LLM_BACKEND=ollama
# Local model for query expansion (default backend)
#PRIMARY_MODEL=qwen3:8b

# ── Tagging (auto-tag / re-analyze) cloud preference ───────────────────────
# Cloud backend tried FIRST for tagging, guarded by a circuit breaker → local
# fallback. Default `openrouter`; with no key it falls straight through to
# local, so keyless still works. Empty string = pure local.
#TAGGING_CLOUD_BACKEND=openrouter
#TAGGING_CLOUD_COOLDOWN_S=300
#CLOUD_CALL_TIMEOUT_S=50

# OpenRouter — free-tier cloud LLM. Get a key: https://openrouter.ai
#OPENROUTER_API_KEY=
#OPENROUTER_PRIMARY_MODEL=openai/gpt-oss-20b:free
# Optional free-tier attribution headers (harmless if left blank)
#OPENROUTER_REFERER=
#OPENROUTER_TITLE=AI Film Library

# ── Other LLM providers (optional) ─────────────────────────────────────────
#ANTHROPIC_API_KEY=
#ANTHROPIC_PRIMARY_MODEL=claude-sonnet-4-20250514
#GEMINI_API_KEY=
#GEMINI_PRIMARY_MODEL=gemini-3.5-flash

# ── LLM fallback (when the primary backend 429s / times out) ───────────────
#LLM_FALLBACK_BACKEND=ollama
#LLM_FALLBACK_MODEL=qwen2.5:1.5b

# ── Embedding ──────────────────────────────────────────────────────────────
# ollama (default, local bge-m3) | sentence-transformers (needs the -st image)
#EMBEDDING_BACKEND=ollama
#EMBEDDING_MODEL=bge-m3
#OLLAMA_HOST=http://localhost:11434

# ── Search query understanding (ADR 0002) ──────────────────────────────────
#USE_QUERY_EXPANSION=true
#QUERY_EXPANSION_TIMEOUT=20.0

# ── External data (optional — only for the TMDb enrichment scripts) ────────
#TMDB_API_KEY=

# ── Vector DB (Qdrant) ─────────────────────────────────────────────────────
# Compose sets these on the backend service already; override for host runs.
#QDRANT_HOST=localhost
#QDRANT_PORT=6333
#QDRANT_COLLECTION=film_vectors

# ── Paths ──────────────────────────────────────────────────────────────────
#DB_PATH=data/film_library.db
#DIMENSION_MAPPING_PATH=data/dimension-mapping.json
# Demo-chip queries warmed at startup (compose mounts it at /app/chips.json)
#CHIPS_PATH=frontend/chips.json

# ── Edge Basic Auth for the admin/tag console (ADR 0025; optional) ─────────
# Only used with docker-compose.caddy.yml (Caddy in front of the frontend).
# Hash a password: docker run --rm caddy:2 caddy hash-password -p 'yourpass'
# CADDY_SITE_ADDRESS: a hostname → Caddy auto-HTTPS; ":80" → plain HTTP behind
# a TLS-terminating proxy (e.g. Traefik).
#CADDY_SITE_ADDRESS=:80
#BASIC_AUTH_USER=admin
#BASIC_AUTH_HASH=
